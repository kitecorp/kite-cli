<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Suppress verbose framework logs -->
        <Logger name="org.hibernate" level="warn"/>
        <Logger name="org.hibernate.SQL" level="warn"/>
        <Logger name="org.hibernate.orm" level="warn"/>
        <Logger name="org.hibernate.engine" level="warn"/>
        <Logger name="com.zaxxer.hikari" level="warn"/>
        <Logger name="org.springframework" level="warn"/>
        <Logger name="io.grpc" level="warn"/>

        <!-- Suppress distribution/engine logs during CLI usage -->
        <Logger name="cloud.kitelang.engine" level="warn"/>

        <!-- Kite CLI logs at info by default -->
        <Logger name="cloud.kitelang.cli" level="info"/>

        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
